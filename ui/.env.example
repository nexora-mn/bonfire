# Copy to .env and fill in from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key

# Sanity (blog) — project ID from sanity.io/manage
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Public origin of the site, used for canonical URLs, Open Graph and the sitemap
VITE_SITE_URL=https://your-domain.com

# Encore backend (server-only; the browser never calls it directly).
# Defaults to http://localhost:4000 (`encore run`).
API_URL=http://localhost:4000

# Sentry — DSN from Project Settings → Client Keys. Public; used by browser and server.
VITE_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# Build only: source map upload. Leave the token empty to skip the upload.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=
